<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Luxury Car Gallery</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:#0d0d0d;
      padding:40px 20px;
      color:white;
    }

    .title{
      text-align:center;
      font-size:42px;
      margin-bottom:40px;
      letter-spacing:2px;
      font-weight:bold;
    }

    .gallery{
      max-width:1300px;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:22px;
    }

    .card{
      position:relative;
      overflow:hidden;
      border-radius:18px;
      cursor:pointer;
      background:#1a1a1a;
      box-shadow:0 10px 25px rgba(0,0,0,0.4);
    }

    .card img{
      width:100%;
      height:320px;
      object-fit:cover;
      display:block;
      transition:0.5s ease;
    }

    /* Overlay */
    .overlay{
      position:absolute;
      inset:0;
      background:rgba(0,0,0,0.45);
      display:flex;
      justify-content:center;
      align-items:center;
      opacity:0;
      transition:0.5s ease;
    }

    .content{
      text-align:center;
      transform:translateY(25px);
      transition:0.5s ease;
      padding:15px;
    }

    .content h2{
      font-size:30px;
      margin-bottom:8px;
    }

    .content p{
      font-size:14px;
      opacity:0.9;
      line-height:1.5;
    }

    /* Hover Effects */
    .card:hover img{
      transform:scale(1.15);
      filter:brightness(65%);
    }

    .card:hover .overlay{
      opacity:1;
    }

    .card:hover .content{
      transform:translateY(0);
    }

    /* Responsive */

    @media(max-width:768px){

      .title{
        font-size:32px;
      }

      .card img{
        height:260px;
      }

      .content h2{
        font-size:24px;
      }

    }

    @media(max-width:480px){

      body{
        padding:25px 15px;
      }

      .title{
        font-size:26px;
      }

      .card img{
        height:220px;
      }

    }

  </style>
</head>

<body>

  <h1 class="title">Luxury Car Gallery</h1>

  <div class="gallery">

    <!-- BMW -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?q=80&w=1200&auto=format&fit=crop" alt="BMW">

      <div class="overlay">
        <div class="content">
          <h2>BMW</h2>
          <p>Elegant performance with modern luxury design.</p>
        </div>
      </div>
    </div>

    <!-- Lamborghini -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?q=80&w=1200&auto=format&fit=crop" alt="Lamborghini">

      <div class="overlay">
        <div class="content">
          <h2>Lamborghini</h2>
          <p>Extreme speed and iconic supercar styling.</p>
        </div>
      </div>
    </div>

    <!-- Ferrari -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1200&auto=format&fit=crop" alt="Ferrari">

      <div class="overlay">
        <div class="content">
          <h2>Ferrari</h2>
          <p>Italian engineering with racing DNA.</p>
        </div>
      </div>
    </div>

    <!-- Porsche -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1502877338535-766e1452684a?q=80&w=1200&auto=format&fit=crop" alt="Porsche">

      <div class="overlay">
        <div class="content">
          <h2>Porsche</h2>
          <p>Classic sporty design with premium comfort.</p>
        </div>
      </div>
    </div>

    <!-- Audi -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?q=80&w=1200&auto=format&fit=crop" alt="Audi">

      <div class="overlay">
        <div class="content">
          <h2>Audi</h2>
          <p>Minimal futuristic styling and advanced tech.</p>
        </div>
      </div>
    </div>

    <!-- Mercedes -->
    <div class="card">
      <img src="https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?q=80&w=1200&auto=format&fit=crop" alt="Mercedes">

      <div class="overlay">
        <div class="content">
          <h2>Mercedes</h2>
          <p>Luxury, comfort and stunning road presence.</p>
        </div>
      </div>
    </div>

  </div>

</body>
</html>
